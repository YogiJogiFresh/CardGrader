{
  "name": "cardgrader",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.21",
    "expo-camera": "~57.0.4",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "patch-package",
    "pwa:build": "npm run build --workspace @cardgrader/web",
    "pwa:build:github-pages": "npm run build:github-pages --workspace @cardgrader/web",
    "pwa:dev": "npm run dev --workspace @cardgrader/web",
    "pwa:preview": "npm run preview --workspace @cardgrader/web",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspace @cardgrader/web",
    "web": "expo start --web"
  },
  "private": true
}
